# ---------------------------------------------------------------------------
# Bizwoke Nova backend configuration. Copy to .env (never commit .env).
# Use separate files/secret stores per environment (development, staging, production).
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- Core (required) --------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Number of trusted reverse proxies in front of the app (for correct client IPs / rate limits).
TRUST_PROXY=0
# Must be a replica set (or Atlas) - transactions are required for booking.
MONGODB_URI=mongodb://localhost:27017/bizwoke_nova?replicaSet=rs0
JWT_ACCESS_SECRET=replace_with_a_secure_random_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=bizwoke-nova
# Signs customer "manage appointment" links. Must differ from JWT_ACCESS_SECRET.
APPOINTMENT_TOKEN_SECRET=replace_with_a_different_secure_random_secret
APPOINTMENT_TOKEN_TTL=30d
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12
# Allow POST /auth/register to create a business tenant (self-service signup).
ALLOW_SELF_SIGNUP_TENANTS=true

# --- HTTP security ----------------------------------------------------------
# Comma-separated browser origins. Wildcard (*) is rejected in staging/production.
CORS_ORIGINS=
BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
PUBLIC_RATE_LIMIT_MAX=60
SWAGGER_ENABLED=true

# --- Redis / BullMQ (optional; without it jobs run in-process, non-durable) --
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# --- AI (optional; leave empty to run with AI marked unavailable) -----------
# anthropic | openai  (openai = any OpenAI-compatible Chat Completions endpoint)
AI_PROVIDER=
AI_API_KEY=
# Required for openai; defaults to claude-sonnet-5-5 for anthropic.
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_TOOL_ITERATIONS=5

# --- WhatsApp Business Platform (optional; Meta Cloud API) ------------------
# meta
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_URL=https://graph.facebook.com

# --- Email (optional; needed for password reset and email notifications) ----
# smtp
EMAIL_PROVIDER=
SMTP_URL=
EMAIL_FROM=

# --- File storage (exports / temporary imports) -----------------------------
# local | s3 (any S3-compatible service: AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# --- Excel limits -----------------------------------------------------------
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_ROWS=5000
EXPORT_MAX_ROWS=50000
EXPORT_RETENTION_HOURS=24

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- One-off: scripts/create-super-admin.ts ---------------------------------
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
