{
  "name": "bizwoke-nova-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Bizwoke Nova - multi-tenant AI appointment booking and enquiry automation backend",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/jobs/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/jobs/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:indexes": "tsx scripts/sync-indexes.ts",
    "db:seed-admin": "tsx scripts/create-super-admin.ts",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
